+        private static string FindSpeedTreeRtDll(string unpackDir)
+        {
+            string[] dllNames =
+            {
+                "SpeedTreeRT_wo_32.dll", "SpeedTreeRT_wo.dll", "SpeedTreeRT.dll",
+                "speedtreert_wo_32.dll", "speedtreert_wo.dll", "speedtreert.dll"
+            };
+
+            var dirs = new List<string>();
+            if (!string.IsNullOrEmpty(unpackDir))
+            {
+                string cur = unpackDir;
+                for (int i = 0; i < 4 && !string.IsNullOrEmpty(cur); i++)
+                {
+                    dirs.Add(cur);
+                    dirs.Add(Path.Combine(cur, "bin32"));
+                    dirs.Add(Path.Combine(cur, "win32"));
+                    dirs.Add(Path.Combine(cur, "x86"));
+                    cur = Path.GetDirectoryName(cur);
+                }
+            }
+            dirs.Add(Environment.CurrentDirectory);
+
+            foreach (string dir in dirs)
+            {
+                if (string.IsNullOrEmpty(dir)) continue;
+                foreach (string name in dllNames)
+                {
+                    string path = Path.Combine(dir, name);
+                    if (File.Exists(path)) return path;
+                }
+            }
+
+            // Let Windows DLL search path try PATH/current directory as a final fallback.
+            return "SpeedTreeRT.dll";
+        }
+
+        private static bool CanLoadWithSpeedTreeRt(string resource)
+        {
+            return resource.EndsWith(".spt", StringComparison.OrdinalIgnoreCase) ||
+                   resource.EndsWith(".ctree", StringComparison.OrdinalIgnoreCase);
+        }
+
+        private static Texture LoadSpeedTreeRtTexture(string rootDir, string resourceName, string materialOrTextureName, WoTPackageManager resMgr)
+        {
+            if (resMgr == null || string.IsNullOrEmpty(materialOrTextureName)) return null;
+            foreach (string candidate in SpeedTreeRtTextureCandidates(resourceName, materialOrTextureName))
+            {
+                byte[] bytes = resMgr.ReadBytes(candidate);
+                if (bytes == null) continue;
+                try
+                {
+                    Texture2D tex;
+                    if (bytes.Length >= 4 && BitConverter.ToUInt32(bytes, 0) == DdsDecoder.MAGIC)
+                    {
+                        try { tex = DdsDecoder.ReadDecompressed(bytes, Path.GetFileNameWithoutExtension(candidate), false, true); }
+                        catch { tex = DdsDecoder.Read(bytes, Path.GetFileNameWithoutExtension(candidate), false); }
+                    }
+                    else
+                    {
+                        tex = new Texture2D(2, 2, TextureFormat.RGBA32, false, false)
+                        {
+                            name = Path.GetFileNameWithoutExtension(candidate),
+                            wrapMode = TextureWrapMode.Repeat,
+                        };
+                        if (!tex.LoadImage(bytes, false))
+                        {
+                            UnityEngine.Object.DestroyImmediate(tex);
+                            continue;
+                        }
+                    }
+
+                    tex.name = SafeAssetName(PathName(candidate) + "_" + StableHash32(candidate).ToString("X8"));
+                    tex.wrapMode = TextureWrapMode.Repeat;
+                    tex.filterMode = FilterMode.Bilinear;
+                    string texPath = $"{rootDir}/Textures/{tex.name}.asset";
+                    SaveAsset(tex, texPath);
+                    return AssetDatabase.LoadAssetAtPath<Texture2D>(texPath) ?? tex;
+                }
+                catch { /* try next candidate */ }
+            }
+            return null;
+        }
+
+        private static IEnumerable<string> SpeedTreeRtTextureCandidates(string resourceName, string materialOrTextureName)
+        {
+            string tex = NormalizeResource(materialOrTextureName);
+            string resDir = Path.GetDirectoryName(NormalizeResource(resourceName))?.Replace('\\', '/') ?? string.Empty;
+            string noExt = RemoveExtension(tex);
+
+            // Names returned by old SpeedTreeRT are often *.tga while WoT packages
+            // contain the same texture as *.dds.  Try DDS first for Unity import.
+            foreach (string ext in new[] { ".dds", ".png", ".tga", ".jpg", ".jpeg" })
+            {
+                string c = noExt + ext;
+                yield return c;
+                if (!c.StartsWith("content/", StringComparison.OrdinalIgnoreCase)) yield return "content/" + c;
+                if (!string.IsNullOrEmpty(resDir) && c.IndexOf('/') < 0) yield return resDir + "/" + c;
+                if (!string.IsNullOrEmpty(resDir) && c.IndexOf('/') < 0) yield return "content/" + resDir + "/" + c;
+            }
+
+            yield return tex;
+            if (!tex.StartsWith("content/", StringComparison.OrdinalIgnoreCase)) yield return "content/" + tex;
+        }
+
         private static uint StableHash32(string s) { unchecked { uint h = 2166136261u; if (s == null) return h; foreach (char c in s) { h ^= (uint)char.ToLowerInvariant(c); h *= 16777619u; } return h; } }
 
